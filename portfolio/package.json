{
  "name": "kim-seojun-career-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets:prototype": "node scripts/generate-prototype-assets.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:media": "node scripts/validate-media.mjs",
    "validate": "npm run validate:content && npm run validate:media",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run validate && vite build && node scripts/validate-output.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "axe-core": "^4.10.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
